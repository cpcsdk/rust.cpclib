    "submenus": [
      {
        "id": "cpclib.debugWithEmulatorMenu",
        "label": "CPClib: Debug with..."
      },
      {
        "id": "cpclib.runWithEmulatorMenu",
        "label": "CPClib: Run with..."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cpclib.pickInkColor",
          "when": "(editorLangId == basm || editorLangId == locomotive-basic || editorLangId == catart-basic) && cpclib.cursorOnInkColor",
          "group": "9_cutcopypaste"
        },
        {
          "command": "cpclib.findPeepholeInSelection",
          "when": "editorLangId == basm && editorHasSelection",
          "group": "9_cutcopypaste"
        },
        {
          "command": "cpclib.findPeepholeInFile",
          "when": "editorLangId == basm && !editorHasSelection",
          "group": "9_cutcopypaste"
        },
        {
          "command": "cpclib.assembleThisFile",
          "when": "editorLangId == basm",
          "group": "9_cutcopypaste"
        },
        {
          "command": "cpclib.debugThisFile",
          "when": "editorLangId == basm || editorLangId == locomotive-basic",
          "group": "9_cutcopypaste"
        }
      ],
      "explorer/context": [
        {
          "command": "cpclib.debugSnapshot",
          "when": "resourceExtname =~ /^\\.sna$/i",
          "group": "cpclib"
        },
        {
          "command": "cpclib.runSnapshot",
          "when": "resourceExtname =~ /^\\.sna$/i",
          "group": "cpclib"
        },
        {
          "command": "cpclib.debugDisk",
          "when": "resourceExtname =~ /^\\.dsk$/i",
          "group": "cpclib"
        },
        {
          "command": "cpclib.runDisk",
          "when": "resourceExtname =~ /^\\.dsk$/i",
          "group": "cpclib"
        },
        {
          "submenu": "cpclib.debugWithEmulatorMenu",
          "when": "resourceExtname =~ /^\\.(sna|dsk)$/i",
          "group": "cpclib"
        },
        {
          "submenu": "cpclib.runWithEmulatorMenu",
          "when": "resourceExtname =~ /^\\.(sna|dsk)$/i",
          "group": "cpclib"
        },
        {
          "command": "cpclib.playMusic",
          "when": "resourceExtname =~ /^\\.(aks|sks|128|vt2|wyz)$/i",
          "group": "cpclib"
        },
        {
          "command": "cpclib.buildMusicDsk",
          "when": "resourceExtname =~ /^\\.(aks|sks|128|vt2|wyz)$/i",
          "group": "cpclib"
        }
      ],
