          "command": "cpclib.runWith.emulator1984-js",
          "when": "false"
        },
        {
          "command": "cpclib.runWith.emulator1984-js.needsInstall",
          "when": "false"
        },
        {
          "command": "cpclib.runWith.rvm",
          "when": "false"
        },
        {
          "command": "cpclib.runWith.rvm.needsInstall",
          "when": "false"
        },
        {
          "command": "cpclib.debugWith.amspiritlite",
          "when": "false"
        },
        {
          "command": "cpclib.debugWith.amspiritlite.needsInstall",
          "when": "false"
        },
        {
          "command": "cpclib.debugWith.1984js",
          "when": "false"
        },
        {
          "command": "cpclib.debugWith.1984js.needsInstall",
          "when": "false"
        },
        {
          "command": "cpclib.openDisassembly",
          "when": "inDebugMode"
        },
        {
          "command": "cpclib.openMemoryView",
          "when": "inDebugMode"
        },
        {
          "command": "cpclib.openAllRegisterMemoryViews",
          "when": "inDebugMode"
        },
        {
          "command": "cpclib.openCrtcView",
          "when": "inDebugMode"
        },
        {
          "command": "cpclib.openBasicListing",
          "when": "inDebugMode"
        },
        {
          "command": "cpclib.revealProgramCounter",
          "when": "inDebugMode"
        }
      ]
    },
    "debuggers": [
      {
        "type": "basm",
        "label": "Amstrad CPC (basm)",
        "languages": [
          "basm",
          "locomotive-basic"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The .asm, .bas, .sna or .dsk file to debug. A .bas file is tokenised and loaded but not auto-run - type RUN in the emulator once it opens. A .sna is loaded exactly as saved, with no source map - breakpoints and stepping work at the address level only. A .dsk is mounted in drive A at a cold boot, landing at Ready - also not auto-run, and also with no source map.",
                "default": "${file}"
              },
              "rule": {
                "type": "string",
                "description": "A bndbuild rule that launches the emulator; its 'emu ... run' command is re-issued as 'debug'."
              },
              "buildFile": {
                "type": "string",
                "description": "The build file the rule lives in. Defaults to the nearest one."
              },
              "emulator": {
                "type": "string",
                "description": "Which emulator to debug in - \"1984js\" or \"amspiritlite\". Any other value falls back to 1984js with a notice. Use the explorer context menu's \"Debug with a specific emulator...\" to pick one per launch instead of editing this.",
                "default": "1984js"
              },
              "watchLabels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Labels to report writes to, using the emulator's write-watch channels. The program's own `BREAKPOINT ... TYPE=MEM` directives are watched too, and come first when channels are scarce.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break at the address the snapshot starts from, before it runs.",
                "default": false
              },
              "openInWebview": {
                "type": "boolean",
                "description": "Show the emulator in a VS Code tab. Turn off to open it in your browser instead.",
                "default": true
              },
              "topOfStack": {
                "type": "string",
                "description": "Where the program's stack starts - a label or an address. The call stack is walked no further than this. Defaults to a `stack_top`/`stack` label if the program has one."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "basm",
            "request": "launch",
            "name": "Debug this .asm file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "CPC: debug the current .asm file",
            "description": "Assemble the open file and debug it in 1984js",
            "body": {
              "type": "basm",
              "request": "launch",
              "name": "Debug this .asm file",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "CPC: debug a bndbuild rule",
            "description": "Re-issue a rule's 'emu ... run' as a debug session",
            "body": {
              "type": "basm",
              "request": "launch",
              "name": "Debug the demo",
              "rule": "run"
            }
          },
          {
            "label": "CPC: debug the current .bas file",
            "description": "Tokenise the open BASIC file and load it for debugging",
            "body": {
              "type": "basm",
              "request": "launch",
              "name": "Debug this .bas file",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "CPC: debug a .sna snapshot",
            "description": "Load a raw snapshot exactly as saved, no source map",
            "body": {
              "type": "basm",
              "request": "launch",
              "name": "Debug this snapshot",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "CPC: debug a .dsk disk",
            "description": "Mount a raw disk in drive A at a cold boot, no source map",
            "body": {
              "type": "basm",
              "request": "launch",
              "name": "Debug this disk",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "basm"
      },
      {
        "language": "locomotive-basic"
      }
    ],
    "taskDefinitions": [
      {
        "type": "bndbuild",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "The bndbuild target to build"
          },
          "file": {
            "type": "string",
            "description": "Absolute path to the .bnd/.build file, or the host .asm file for an embedded rule (optional, inferred from workspace if omitted)"
          },
          "embedded": {
            "type": "boolean",
            "description": "True for a rule embedded in a .asm file's own #!bndbuild comment block, run via the LSP's cpclib.runRule command rather than a real bndbuild CLI invocation"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "basm",
        "owner": "basm",
        "fileLocation": [
          "search",
          {
            "include": [
              "${workspaceFolder}"
            ]
          }
        ],
        "pattern": [
          {
            "regexp": "^(?:\\[[^\\]]*\\]\\s*)?(error|warning):\\s+(.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^(?:\\[[^\\]]*\\]\\s*)?\\s*(?:\u250c\u2500|-->)\\s+(.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "configuration": {
      "title": "CPClib LSP",
      "properties": {
        "cpclib.debug.openInWebview": {
          "type": "boolean",
          "default": true,
          "description": "Show the emulator in a VS Code tab during a debug session. Turn off to open it in your normal browser instead."
        },
        "cpclib.breakpointDirective": {
          "type": "boolean",
          "default": true,
          "description": "Mirror editor breakpoints (the red dot) into the source as a basm 'breakpoint' directive on that line, removing it when the breakpoint is cleared. Turn this off if you would rather your .asm files were never edited on your behalf."
        },
        "cpclib-lsp.serverPath": {
          "type": "string",
          "default": "cpclib-lsp",
          "description": "Path to the cpclib-lsp binary. Defaults to 'cpclib-lsp' (must be in PATH, e.g. after cargo install)."
        },
        "cpclib-lsp.bndbuildPath": {
          "type": "string",
          "default": "",
          "description": "Path to a standalone bndbuild binary to use instead of the LSP binary's own 'cpclib-lsp --bndbuild' mode. Leave empty (the default) unless you specifically need a different bndbuild build/version than the one bundled with cpclib-lsp - no separate bndbuild install is required otherwise."
        },
        "cpclib-lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication between VS Code and the server (useful for debugging)."
        }
      }
    },
    "configurationDefaults": {
      "[locomotive-basic]": {
        "editor.formatOnType": true
      },
      "[catart-basic]": {
        "editor.formatOnType": true
      },
      "[basm]": {
        "editor.formatOnType": true
      },
      "files.associations": {
        "*.bnd": "bndbuild",
        "*.build": "bndbuild"
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
