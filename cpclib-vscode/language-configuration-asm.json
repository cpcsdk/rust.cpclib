{
    "comments": {
        "lineComment": ";"
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "\"", "close": "\"" },
        { "open": "'", "close": "'" }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "(?i)^\\s*(MACRO|REPEAT|REPT|IF|IFDEF|IFNDEF|WHILE|FOR|MODULE|STRUCT)\\b",
        "decreaseIndentPattern": "(?i)^\\s*(MEND|REND|ENDM|ENDIF|WEND|ENDFOR|ENDMODULE|ENDS)\\b"
    },
    "wordPattern": "[.@]?[A-Za-z_][A-Za-z0-9_@.]*"
}
